# 众像美术馆后端 - 环境变量配置

# ======================================
# 必填项（部署到 Zeabur 时必须设置）
# ======================================

# JWT 签名密钥（随机字符串，越长越安全）
JWT_SECRET=your-super-secret-jwt-key-here

# ======================================
# Zeabur 持久化存储（重要！）
# ======================================
# 在 Zeabur 控制台创建 Volume 并挂载到 /data
# 然后在环境变量中设置此项
DATA_DIR=/data

# ======================================
# 跨域配置
# ======================================
# 你的前端域名（Vercel 地址或自定义域名）
FRONTEND_URL=https://www.zxmeishu.fun

# ======================================
# 可选项
# ======================================
# 服务端口（Zeabur 会自动注入 PORT，无需手动设置）
# PORT=3000

# 运行环境
NODE_ENV=production
